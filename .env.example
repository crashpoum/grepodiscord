# --- Required for the bot ---
# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=
# Application ID (General Information → Application ID)
CLIENT_ID=

# --- Optional ---
# Register commands to one server instantly (recommended for a private alliance bot). Empty = global (up to ~1h to appear).
DEV_GUILD_ID=
# SQLite file (inside the container this lives on the ./data volume; an old grepodiscord.sqlite is renamed automatically)
DB_PATH=./data/grepocord.sqlite
# Markets the bot accepts (comma-separated)
MARKETS=gr,en
# Default language for new servers: en | el
DEFAULT_LANG=en
# How often to poll official world files (minutes). Files change ~hourly; unchanged files cost a 304.
REFRESH_MINUTES=15
# Self-imposed GrepoData request budget per minute (their firewall bans above ~400/min)
GREPODATA_RPM=30
# User-Agent sent to grepolis.com and grepodata.com (put a contact so operators can reach you)
USER_AGENT=GrepoCord/1.1 (private alliance bot; contact: you@example.com)
LOG_LEVEL=info

# --- GrepoData City Indexer intel (optional; you can also use /grepodata token in Discord) ---
# Your GrepoData account tokens (NOT your game password): grepodata.com → F12 → Application/Storage → Local Storage.
# Access tokens last 24h; with the refresh token the bot renews itself daily (refresh tokens last 90 days and rotate).
GREPODATA_TOKEN=
GREPODATA_REFRESH_TOKEN=
# The ONE Discord server these tokens belong to (intel is never shown elsewhere). Default: DEV_GUILD_ID
GREPODATA_GUILD_ID=
# Who gets a DM before the token expires (Discord user ID). Default: the server owner
GREPODATA_ADMIN_ID=
# Optional fallback: GrepoData login (email + password of grepodata.com) to log in again if renewal fails
GREPODATA_LOGIN=
GREPODATA_PASSWORD=

# --- AI: Gemini, FREE TIER ONLY (optional; powers /report and writes the weekly /newspaper) ---
# Create a key at https://aistudio.google.com/apikey in a Google project WITHOUT billing enabled (= free tier, can never be charged).
# Without a key: /report replies that AI is off, and the newspaper uses a template summary.
GEMINI_API_KEY=
# Free-tier flash models only (pro/paid models are refused and replaced by the default). Default: gemini-3.5-flash-lite (vision + text)
GEMINI_MODEL=
# Self-imposed caps, below the free-tier quota of the default model (shared by all servers using this bot)
GEMINI_RPM=8
GEMINI_RPD=400
